HF_HOME="./.hf_cache"
PIP_CACHE_DIR="./.pip_cache"

# Set to true to use 'paraphrase-multilingual-MiniLM-L12-v2' (supports 50+ languages, ~500MB RAM)
# Set to false to use 'all-MiniLM-L6-v2' (English only, insanely fast, ~100MB RAM)
MULTILINGUAL_MODE=true

# Enable or Disable AI Tactical Cues Framework
# Set to false to run as a lightweight, pure transcription teleprompter (saves memory)
ENABLE_LOCAL_RAG=true

# ===== Speech-to-Text (Whisper) =====
# Whisper model. Default is multilingual and fast on Apple Silicon (handles zh+en code-switching).
# A/B against a smaller model by changing this and RESTARTING (mlx caches one model per process).
# Lighter option: mlx-community/whisper-small-mlx
WHISPER_MODEL="mlx-community/whisper-large-v3-turbo"

# Force a language to skip auto-detection. Leave EMPTY for auto-detect (best for mixed zh/en).
# Examples: zh, en
WHISPER_LANGUAGE=""

# Speaker-mic commit style. "window" = whole utterance per pause (clean transcript, recommended).
# "localagreement" = incremental word-by-word (lower latency, more compute). The Participant mic
# auto-uses localagreement whenever ENABLE_LOCAL_RAG=true so cues fire within ~2s.
TRANSCRIBE_MODE="window"
