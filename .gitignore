.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Secrets & Environment Variables
.env

# Python Cache
.pip_cache/
.pytest_cache/

# Meeting History & Logs
history/
logs/

# context
context/

# ASR bake-off audio (synthesized, or fetched from a public corpus into fixtures/asr/real).
# README and MANIFEST stay tracked. Wipe the corpus copy with: rm -rf fixtures/asr/real
fixtures/asr/**/*.wav
fixtures/asr/**/*.aiff
fixtures/asr/results/
# Corpus copy and its ground truth: third-party text we should not redistribute, and fully
# reproducible from tools/fetch_real_fixtures.py at the recorded seed.
fixtures/asr/real/

# Ignore generated documentation HTML files
architecture_review.html
*.html

# AI Artifacts
walkthrough.md
task.md
implementation_plan.md

# Compiled tap helper. The source `src/native/aegis_tap.m` is tracked; the binary is rebuilt by
# `setup_mac.sh` because it is machine-specific and unsigned.
src/native/aegis_tap

# Trace for the PreToolUse bash guard in .claude/settings.json. Append-only, local.
# Named without the word it matches on: a filename containing that word makes every command
# that reads it look like a process-kill to an outer guard. Found 2026-08-18.
.claude/bash-guard.log

# Disposable benchmark corpora fetched for evaluation only. Remove with: rm -rf .corpora-bakeoff
.corpora-bakeoff/

# Pinned diarization interpreter (V93). Disposable: rm -rf .venv-diarize
.venv-diarize/

# Local LLM interpreter for the generative advisor (V94). Disposable: rm -rf .venv-llm
.venv-llm/

# Third-party question-answering corpus for the retrieval probe (DRCD, CC BY-SA 3.0).
# Fetched on demand by tools/probe_rag_positives.py; disposable: rm -rf .corpora-qa
.corpora-qa/
