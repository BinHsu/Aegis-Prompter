# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
# Kept aside by setup_mac.sh when it rebuilds .venv on a newer interpreter. Safe to delete.
.venv.old/
.venv-py39/
# Disposable Python ≥3.10 env for ASR bake-off / Qwen measurement only. Wipe with:
#   rm -rf .venv-bakeoff
.venv-bakeoff/
venv/
env/

# Model Weights / Caches
.hf_cache/
# Bake-off weights, kept out of the product's storage root so the whole experiment is one
# delete: rm -rf .venv-bakeoff .hf_cache-bakeoff .vendor-bakeoff
.hf_cache-bakeoff/
# Local mirror of the pinned mlx-qwen3-asr wheel. Protects this machine only; a clone gets the
# provenance from docs/decisions/0008 instead. See that record before assuming it is optional.
.vendor-bakeoff/

